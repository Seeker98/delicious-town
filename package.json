{
  "name": "delicious-town",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "infra:test": "docker compose -f infra/compose.test.yml up -d --wait",
    "infra:dev": "docker compose -f infra/compose.dev.yml up -d --wait",
    "sim": "pnpm --filter @dt/server sim",
    "sim:explain": "pnpm --filter @dt/server sim:explain",
    "sim:bench": "pnpm --filter @dt/server sim:bench"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
