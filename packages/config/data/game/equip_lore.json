{
  "rename": [
    { "id": 33, "name": "灵魂之沙利叶的无情之铲", "desc": "厨艺+18。厨塔第四层的守护者沙利叶多年等不来挑战者，只好对着空灶日夜翻炒，铲下从不留情。" },
    { "id": 34, "name": "灵魂之沙利叶的无情之刃", "desc": "刀工+18。沙利叶切菜从不看砧板，他说刀比人诚实，落下去就不回头。" },
    { "id": 56, "name": "沉默之度玛的静谧之镬", "desc": "随机增加25点属性。育才长老度玛教徒弟从不开口，只让他们守着这口镬，看火自己说话。" },
    { "id": 57, "name": "沉默之度玛的静谧之瓶", "desc": "随机增加25点属性。度玛的调味瓶总是满的，他说味道要静下心才尝得出来。" },
    { "id": 58, "name": "沉默之度玛的静谧之冠", "desc": "随机增加25点属性。度玛收过的弟子里，只有一个再也没回到第六层来戴这顶冠。" },
    { "id": 59, "name": "裁决之巴贝雷特的悲鸣之铲", "desc": "随机增加35点属性。裁决长老巴贝雷特评判菜品只用这把铲，铲落之处，败者的菜在锅里悲鸣。" },
    { "id": 60, "name": "裁决之巴贝雷特的悲鸣之刃", "desc": "随机增加35点属性。巴贝雷特说，刀声就是裁决，切得不干净的人连上桌的资格都没有。" },
    { "id": 61, "name": "裁决之巴贝雷特的悲鸣之冠", "desc": "随机增加35点属性。这顶冠是厨塔给裁决长老的信物，巴贝雷特戴着它判过的比试，没有一场翻过案。" },
    { "id": 352, "name": "神谕之阿卡玛的荣耀之铲", "desc": "厨艺+38。厨塔塔主阿卡玛以神谕考验来者，这把铲见证了他一生的荣耀。", "awardflag": 8 },
    { "id": 353, "name": "神谕之阿卡玛的荣耀之刃", "desc": "刀工+38。阿卡玛的刀法从不示人，只在神谕选中的挑战者面前出鞘。", "awardflag": 8 },
    { "id": 354, "name": "神谕之阿卡玛的荣耀之镬", "desc": "火候+38。阿卡玛说，荣耀是一口烧了一辈子的镬，热度要留给接替他的人。", "awardflag": 8 },
    { "id": 356, "name": "神谕之阿卡玛的荣耀之瓶", "desc": "调味+38。瓶中的味道据说传自上届食神，阿卡玛珍藏多年，只等有人配得上它。", "awardflag": 8 },
    { "id": 413, "name": "神谕之阿卡玛的荣耀之冠", "desc": "创意+38。塔主之冠。阿卡玛早已看淡一切，唯一的心愿是在有生之年把它交出去。", "awardflag": 8 }
  ],
